{
  "name": "bursar-near",
  "version": "0.1.0",
  "private": true,
  "description": "Counterparty check for agents that pay through NEAR Intents.",
  "type": "module",
  "bin": {
    "bursar": "./bin/bursar.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/check.test.ts test/quote.test.ts test/signer.test.ts test/touch.test.ts test/p256-intent.test.ts test/intents-dec.test.ts test/pay.test.ts test/mpp.test.ts test/catalog.test.ts test/agents.test.ts test/agent.test.ts test/assets.test.ts test/screenshot.test.ts test/x402.test.ts test/history.test.ts test/mcp.test.ts test/decimals.test.ts test/recorded.test.ts test/verify.test.ts test/eval-agent.test.ts test/phone-hear.test.ts test/code.test.ts test/receive.test.ts test/attack-demo.test.ts",
    "test:count": "node scripts/test-count.mjs",
    "eval:agent": "tsx src/eval-agent-cli.ts",
    "eval:live": "tsx src/eval-live-cli.ts",
    "verify": "tsx src/verify.ts",
    "verify:firmware": "python3 scripts/verify_firmware.py",
    "verify:weights": "tsx src/verify-weights.ts",
    "test:live": "tsx --test test/live.test.ts",
    "demo": "tsx src/demo.ts",
    "demo:attacks": "tsx src/attack-demo.ts",
    "model": "sh scripts/start-model.sh",
    "demo:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "check:readme": "node scripts/check-readme.mjs && node scripts/check-agents.mjs",
    "check:agents": "node scripts/check-agents.mjs",
    "demo:agents": "tsx src/demo-agents.ts",
    "bursar": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@defuse-protocol/intents-sdk": "^0.95.0",
    "@defuse-protocol/nearintents-mpp-sdk": "^0.4.1",
    "@defuse-protocol/one-click-sdk-typescript": "0.1.26",
    "jsqr": "^1.4.0",
    "mppx": "^0.17.0",
    "near-api-js": "5.1.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.0",
    "viem": "^2.57.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.7"
  }
}
